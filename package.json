{
  "name": "sy0-701-interactive",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive CompTIA Security+ SY0-701 learning platform (local, no backend).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "vitest run tests/content.test.ts",
    "coverage-report": "vitest run tests/coverage-report.test.ts --reporter=verbose",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
